{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1", "headers": { "cache-control": "public, max-age=604800" } },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    { "path": "/cron/rechecks", "schedule": "0 0 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 1 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 2 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 3 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 4 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 5 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 6 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 7 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 8 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 9 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 10 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 11 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 12 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 13 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 14 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 15 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 16 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 17 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 18 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 19 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 20 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 21 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 22 * * *" },
    { "path": "/cron/rechecks", "schedule": "0 23 * * *" }
  ]
}
